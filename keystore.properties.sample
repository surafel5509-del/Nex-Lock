# Copy this file to `keystore.properties` in the repository root and fill in your own values.
# `keystore.properties` is git-ignored and must never be committed.
#
# Generate a release key (keep the file outside the repository):
#   keytool -genkeypair -v -keystore ~/nexlock-release.jks -alias nexlock \
#           -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=/absolute/path/to/nexlock-release.jks
storePassword=REPLACE_ME
keyAlias=nexlock
keyPassword=REPLACE_ME
